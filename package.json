{
  "name": "omp-cache-control",
  "version": "1.0.0",
  "description": "Prompt-cache reuse status and idle-session prefix refreshes for Oh My Pi.",
  "type": "module",
  "license": "MIT",
  "author": "ubranch",
  "homepage": "https://github.com/ubranch/omp-cache-control#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ubranch/omp-cache-control.git"
  },
  "bugs": {
    "url": "https://github.com/ubranch/omp-cache-control/issues"
  },
  "keywords": ["omp", "oh-my-pi", "prompt-cache", "cache-warming"],
  "exports": "./cache-control.ts",
  "files": ["cache-control.ts", "cache-control-replay.js", "cache-control-replay.d.ts", "cache-control-replay-entry.ts", "build-cache-replay.ts", "README.md", "CHANGELOG.md", "CONTRIBUTING.md", "SECURITY.md", "LICENSE", "docs/", "assets/readme/"],
  "omp": {
    "extensions": ["./cache-control.ts"]
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build:cache-replay": "bun run ./build-cache-replay.ts",
    "prepack": "bun run build:cache-replay",
    "test": "bun test ./tests/cache-control.test.ts",
    "test:compiled": "bun test ./tests/compiled-cli.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@smithy/core": "3.35.0"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.8.7",
    "@oh-my-pi/pi-catalog": "18.8.7",
    "@oh-my-pi/pi-coding-agent": "18.8.7",
    "@oh-my-pi/pi-tui": "18.8.7",
    "@oh-my-pi/pi-utils": "18.8.7",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  }
}
